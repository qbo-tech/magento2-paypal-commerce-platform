<?php
/** @var PayPal\CommercePlatform\Block\PromoMessage $block */
?>
<?php if ($block->isEnabled()):
    $messageHtml = $block->getPromoMessageText();
    $linkText    = $block->getPromoLinkText();
    $redirectUrl = $block->getPromoRedirectUrl();
    $pageType    = $block->getData('page_type');
    $logoUrl     = $block->getViewFileUrl('PayPal_CommercePlatform::images/paypal-logo.png');

    $linkHtml = '';
    if (!empty($redirectUrl) && !empty($linkText)) {
        $linkHtml = '<a href="' . $block->escapeUrl($redirectUrl) . '" target="_blank" rel="noopener"'
            . ' style="color:#0070e0;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;"'
            . ' onmouseover="this.style.textDecoration=\'underline\';"'
            . ' onmouseout="this.style.textDecoration=\'none\';">'
            . $block->escapeHtml($linkText)
            . '</a>';
    }
?>
<?php if ($pageType === 'cart'): ?>
    <!-- Cart: vertical/stacked layout -->
    <div class="paypal-promo-message-container" style="margin-top:15px;margin-bottom:15px;">
        <div class="pp-slim-banner" style="
            display:flex;
            flex-direction:column;
            align-items:flex-start;
            gap:8px;
            background:#f0f4fb;
            border:1px solid #d6e0f0;
            border-left:4px solid #0070e0;
            border-radius:8px;
            padding:12px 14px;
            box-sizing:border-box;
            width:100%;
            text-align:left;
            font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
        ">
            <img src="<?= $block->escapeUrl($logoUrl) ?>" alt="PayPal" style="height:20px;width:auto;flex:0 0 auto;display:block;">
            <span style="color:#001c64;font-size:12px;line-height:1.35;font-weight:500;text-align:left;">
                <?= /* @noEscape */ $messageHtml ?>
            </span>
            <?= /* @noEscape */ $linkHtml ?>
        </div>
    </div>
<?php else: ?>
    <!-- PDP: horizontal layout -->
    <div class="paypal-promo-message-container" style="margin-top:15px;margin-bottom:15px;">
        <div class="pp-slim-banner" style="
            display:flex;
            align-items:center;
            gap:10px;
            background:#f0f4fb;
            border:1px solid #d6e0f0;
            border-left:4px solid #0070e0;
            border-radius:8px;
            padding:10px 14px;
            box-sizing:border-box;
            width:100%;
            font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;
        ">
            <img src="<?= $block->escapeUrl($logoUrl) ?>" alt="PayPal" style="height:18px;width:auto;flex:0 0 auto;display:block;">
            <span style="flex:1 1 auto;color:#001c64;font-size:12px;line-height:1.3;font-weight:500;">
                <?= /* @noEscape */ $messageHtml ?>
            </span>
            <?= /* @noEscape */ $linkHtml ?>
        </div>
    </div>
<?php endif; ?>
<?php endif; ?>
