<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="PayPal\CommercePlatform\Block\PromoMessage"
                   name="paypal.promo.message.pdp"
                   template="PayPal_CommercePlatform::promo/message.phtml"
                   after="product.info.options.wrapper.bottom">
                <arguments>
                    <argument name="page_type" xsi:type="string">pdp</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
