<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="checkout.cart.methods">
            <block class="PayPal\CommercePlatform\Block\PromoMessage"
                   name="paypal.promo.message.cart"
                   template="PayPal_CommercePlatform::promo/message.phtml"
                   after="checkout.cart.methods.onepage.bottom"
                   before="checkout.cart.methods.multishipping">
                <arguments>
                    <argument name="page_type" xsi:type="string">cart</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
